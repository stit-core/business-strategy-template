    "icon3d": {
      "type": "object",
      "additionalProperties": false,
      "description": "3D-иконки и объекты серии (ui 12/01 §6.2): поля бренда — материал и доля акцента, цвет среды — palette.env_color. Камера, свет, поля кадра и контактная тень — паспорт 3D-серии 3d 06/02 §6 (поле series_passport): один паспорт серии на рендеры Blender и промты генерации.",
      "properties": {
        "material": {
          "type": "string",
          "description": "Материальный язык серии словами промта: материал, отделка, акцентная деталь."
        },
        "camera": {
          "type": "string",
          "description": "Ракурс словами промта генерации; числа ракурса — паспорт 3D-серии (series_passport)."
        },
        "accent_share_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "series_passport": {
          "type": "string",
          "minLength": 3,
          "description": "Паспорт 3D-серии: путь к файлу паспорта серии проекта (рядом со скриптом Blender) или адрес канона «3d/06-materials-lighting-render/02-lighting-camera-composition.md §6». Оттуда — камера, свет key/fill/rim, мир, вид, фон с ловцом теней и поля кадра по типу (3d 11/05 §5, CAM-02)."
        }
      }
    },
    "abstract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "code-first",
            "generate",
