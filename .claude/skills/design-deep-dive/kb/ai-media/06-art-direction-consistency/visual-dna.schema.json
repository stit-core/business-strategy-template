{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:app-design:ai-media:visual-dna:0.1",
  "title": "Visual DNA passport (паспорт визуала бренда) v0.1",
  "description": "Числа и правила изображений бренда: из токенов и стиля UI (derived_from_ui), эталонов (references), разбора сетки брендовых фото сессией Opus (provenance) или арт-дирекции сайта (provenance.art_direction). Куда идёт каждое поле: → промт (style_blocks, palette.image_palette, light, camera, composition, subject_matter, materials, exclusions, references); → постобработка (grade, post); → приёмка (acceptance); иллюстрации — поля системы ui 07/02 и список метафор (его читают экраны кабинета); 3D-серия — материал и доля акцента здесь, камера и свет — паспорт 3D-серии 3d 06/02 §6. Проверка: scripts/ai-media/vlm_to_dna.py validate FILE. Описание полей: 06-art-direction-consistency/01-visual-dna-from-ui.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dna_version",
    "id",
    "checked_at",
    "status",
    "character",
    "palette",
    "grade",
    "light",
    "camera",
    "composition",
    "subject_matter",
    "style_blocks",
    "exclusions",
    "acceptance"
  ],
  "properties": {
    "dna_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Совпадает с series.id в спецификациях ассетов (05-prompting/asset-spec.schema.json)."
    },
    "brand": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ],
      "description": "Паспорт собирает машина, утверждает человек: approved только с approved_by."
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "description": "Версия паспорта и история его подтверждений — та же форма, что lifecycle арт-дирекции (creative 01, art-direction.schema.json). dna_version — версия схемы, а lifecycle.version — версия документа: новую версию утверждённого паспорта называет это поле, а не разница значений.",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "major.minor — версия паспорта; меняется с каждым подтверждённым изменением значений."
        },
        "history": {
          "type": "array",
          "description": "Запись на каждое подтверждение: какая версия, когда, кто подтвердил и что изменилось против предыдущей.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "date",
              "by",
              "change"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              },
              "date": {
                "type": "string",
                "pattern": "^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$"
              },
              "by": {
                "type": "string",
                "minLength": 1,
                "description": "Кто подтвердил: роль у заказчика (имя — только с согласия)."
              },
              "change": {
                "type": "string",
                "minLength": 1,
                "description": "Что изменилось: поля и значения."
              }
            }
          }
        }
      }
    },
    "derived_from_ui": {
      "type": "object",
      "additionalProperties": false,
      "description": "Откуда выведено: карточка стиля ui 11/01, токены DTCG (09/04), семь ручек (11/02 §3, 09/04 §8).",
      "properties": {
        "style_card": {
          "type": "string",
          "description": "«../ui/11-styles-trends/01-style-dictionary-for-quiz.md §15» и т. п."
        },
        "tokens": {
          "type": "string",
          "description": "Путь к tokens.json (DTCG), если паспорт выведен командой vlm_to_dna.py from-tokens."
        },
        "knobs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accent_hex": {
              "$ref": "#/$defs/hex"
            },
            "accent_oklch": {
              "$ref": "#/$defs/oklch"
            },
            "neutral_temp": {
              "enum": [
                "warm",
                "neutral",
                "cool"
              ]
            },
            "neutral_C": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.08
            },
            "base_L": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "radius_px": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            },
            "density": {
              "enum": [
                "compact",
                "default",
                "comfortable"
              ]
            },
            "font_voice": {
              "enum": [
                "neutral-sans",
                "technical-sans",
                "humanist-sans",
                "serif-display",
                "mono"
              ]
            },
            "depth_model": {
              "enum": [
                "flat",
                "border",
                "soft-shadow",
                "hard-shadow",
                "lightness"
              ]
            },
            "theme": {
              "enum": [
                "light",
                "dark",
                "both"
              ]
            }
          }
        },
        "rules_applied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Какие правила вывода применены (01-visual-dna-from-ui.md §3)."
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjectives"
      ],
      "properties": {
        "adjectives": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "Три прилагательных брифа (ui 11/02 §4.2) — не в промт, а для выбора чисел."
        },
        "boldness": {
          "enum": [
            "restrained",
            "balanced",
            "bold"
          ]
        },
        "one_bold_move": {
          "type": "string",
          "description": "Единственный смелый приём страницы (ai-media 01/03 §7.1 «сдержанность»)."
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_palette"
      ],
      "properties": {
        "image_palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/palette_entry"
          },
          "description": "Палитра фото и 3D-сцен. → промт (3–5 цветов с названием и привязкой к объекту) и → приёмка (ΔE строгих цветов, баланс белого)."
        },
        "illustration_palette": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/palette_entry"
          },
          "description": "Палитра плоской графики и 3D-иконок: шаги 200–400 акцента + нейтрали 100–400 (ui 07/02 §2.1), 2–3 акцента + белый + 2–3 серых; цвета обязаны совпасть с токенами (ΔE ≤ 0,02)."
        },
        "chroma_caps": {
          "type": "object",
          "additionalProperties": false,
          "description": "Потолок хромы OKLCH по площади кадра для иллюстраций, 3D и плоской графики: правило ui 11/02 §4.4, на ступень ниже UI. Для фото — median_chroma_max и эталон.",
          "properties": {
            "large_area_C_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4,
              "description": "> 30 % кадра"
            },
            "mid_area_C_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4,
              "description": "5–30 % кадра"
            },
            "small_area_C_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4,
              "description": "< 5 % кадра"
            }
          }
        },
        "median_chroma_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.4,
          "description": "Медиана хромы OKLCH кадра (фото); из эталона ×1,2."
        },
        "forbidden_hues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "reason"
            ],
            "properties": {
              "from": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "to": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "reason": {
                "type": "string"
              },
              "except_share_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Допустимая доля площади (бренд-акцент внутри полосы)."
              }
            }
          }
        },
        "neutral_wb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_b",
            "tol"
          ],
          "description": "b OKLab нейтральных пикселей (C < 0,03): баланс белого серии.",
          "properties": {
            "target_b": {
              "type": "number",
              "minimum": -0.05,
              "maximum": 0.05
            },
            "tol": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.05
            }
          }
        },
        "env_color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hex"
          ],
          "description": "Цвет секции страницы, на которой стоит ассет: фон и рефлексы 3D-сцены, фон выреза и контактной тени — иначе ореол и «наклеенность» (IMG-M25). → промт (фон 3D и иконок), постобработка (композит выреза).",
          "properties": {
            "hex": {
              "$ref": "#/$defs/hex"
            },
            "token": {
              "type": "string"
            },
            "dark_hex": {
              "$ref": "#/$defs/hex"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wb_ab",
        "chroma",
        "black",
        "white",
        "contrast",
        "grain_pct"
      ],
      "description": "→ постобработка: параметрический грейд одним 3D LUT (.cube) на фото, 3D-рендеры и видео; плоский вектор не грейдить. Генератор: vlm_to_dna.py lut. Формула — ../../scripts/ai-media/palette.py parametric_grade.",
      "properties": {
        "wb_ab": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -0.03,
            "maximum": 0.03
          },
          "description": "Сдвиг a, b OKLab нейтралей (вес падает с хромой до 0 при C = 0,08)."
        },
        "chroma": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.2,
          "description": "Множитель хромы."
        },
        "black": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Светлота OKLab чёрной точки после грейда."
        },
        "white": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1,
          "description": "Светлота OKLab белой точки после грейда."
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "description": "Доля S-кривой (smoothstep)."
        },
        "grain_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Зерно поверх (CSS или слой), не в LUT; 1–3 % против «пластика»."
        },
        "lut": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "enum": [
                17,
                33,
                65
              ]
            },
            "file": {
              "type": [
                "string",
                "null"
              ],
              "description": "Путь к .cube, если уже собран; источник истины — числа выше."
            }
          }
        },
        "applies_to": {
          "type": "array",
          "items": {
            "enum": [
              "photo",
              "icon3d",
              "render3d",
              "video",
              "illustration-raster"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "quality"
      ],
      "description": "→ промт. Направление — то же, что у теней UI (ui 07/02 §2.2).",
      "properties": {
        "direction": {
          "enum": [
            "left",
            "right",
            "front",
            "back",
            "top",
            "side",
            "ambient"
          ],
          "description": "Как в asset-spec light.direction."
        },
        "detail": {
          "type": "string",
          "description": "«soft window light from the upper left, 45° above»"
        },
        "quality": {
          "enum": [
            "soft",
            "hard",
            "diffused",
            "mixed"
          ]
        },
        "source": {
          "type": "string"
        },
        "time_of_day": {
          "type": "string"
        },
        "cct_K": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 12000
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens_mm",
        "height",
        "depth_of_field"
      ],
      "description": "→ промт (язык фотографии вместо «cinematic»).",
      "properties": {
        "lens_mm": {
          "type": "number",
          "minimum": 8,
          "maximum": 400
        },
        "height": {
          "enum": [
            "ground",
            "table",
            "eye-level",
            "high",
            "top-down"
          ]
        },
        "angle": {
          "enum": [
            "eye-level",
            "low-angle",
            "high-angle",
            "top-down",
            "45-degree",
            "over-the-shoulder",
            "dutch"
          ],
          "description": "Как в asset-spec composition.angle."
        },
        "depth_of_field": {
          "enum": [
            "shallow",
            "medium",
            "deep"
          ]
        },
        "capture": {
          "type": "string",
          "description": "«documentary, handheld», «tripod still life» …"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_region",
        "negative_space_min",
        "max_elements",
        "asymmetry"
      ],
      "description": "→ промт и → приёмка (ai-media 06/03, 06/04).",
      "properties": {
        "subject_region": {
          "enum": [
            "left-third",
            "center",
            "right-third",
            "top",
            "bottom",
            "full-frame"
          ]
        },
        "text_zone_default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "side",
            "share"
          ],
          "properties": {
            "side": {
              "enum": [
                "left",
                "right",
                "top",
                "bottom",
                "center"
              ],
              "description": "Сторона зоны текста, как в плане страницы; center — текст по центру кадра (центрированный первый экран): зона — центральная полоса шириной share."
            },
            "share": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 0.6
            },
            "surface": {
              "type": "string",
              "description": "Что видно в зоне текста: «a long, evenly lit lawn». Без новых предметов."
            }
          }
        },
        "negative_space_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8,
          "description": "Доля клеток сетки 16×9 с плотностью краёв ≤ 0,06 (composition_metrics.empty_share)."
        },
        "max_elements": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "asymmetry": {
          "type": "boolean",
          "description": "Против «среднего вида»: объект не по центру (asset-spec series.avoid_average)."
        },
        "edge_cut_allowed": {
          "type": "boolean"
        },
        "horizon": {
          "enum": [
            "top-third",
            "middle",
            "bottom-third",
            "none"
          ]
        },
        "master_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "phone_frame": {
          "enum": [
            "separate-master",
            "crop",
            "outpaint"
          ],
          "description": "Телефонный кадр 4:5–9:16: отдельный мастер, кроп или аутпейнт (ai-media 06/03)."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "subject_matter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_props",
        "people_policy",
        "product_policy"
      ],
      "description": "→ промт: сюжеты из предметной области вместо клише (ai-media 01/03 §5.4).",
      "properties": {
        "domain_props": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "motifs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        },
        "places": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "people_policy": {
          "enum": [
            "none",
            "real-only",
            "real-plus-ai-environment",
            "background-silhouettes"
          ],
          "description": "Слоты-доказательства (люди, отзывы, команда) не генерировать (ai-media 01/03 §1–§2)."
        },
        "product_policy": {
          "enum": [
            "real-photo-only",
            "reference-locked",
            "generated-ok"
          ]
        }
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "illustration": {
      "type": "object",
      "additionalProperties": false,
      "description": "2D-иллюстрации и spot-картинки: облик (ui 07/02 §2) и поля системы — места и размеры, формат, перекраска, список метафор (паспорт системы иллюстраций ui 07/02 §3). Экраны кабинета называют метафору пустого состояния по id из списка (`illustration=` у ui:EmptyState).",
      "properties": {
        "medium": {
          "enum": [
            "flat-illustration",
            "vector",
            "line-art",
            "watercolor",
            "gouache",
            "collage",
            "other"
          ]
        },
        "line_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "Толщина линии при display_px (штрих иконок или +0,5)."
        },
        "display_px": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2000
        },
        "radius_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 48,
          "description": "Согласован с radius UI."
        },
        "perspective": {
          "enum": [
            "flat-front",
            "three-quarter",
            "isometric-30",
            "none"
          ]
        },
        "fills": {
          "enum": [
            "flat",
            "tone-on-tone",
            "textured"
          ]
        },
        "shadows": {
          "enum": [
            "none",
            "flat-tone",
            "soft"
          ]
        },
        "background": {
          "enum": [
            "transparent",
            "blob",
            "plate",
            "pattern"
          ]
        },
        "accents_per_image": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "detail_min_px": {
          "type": "number",
          "minimum": 1,
          "maximum": 16
        },
        "saturation_offset": {
          "type": "string",
          "description": "«на 1–2 шага ниже UI»"
        },
        "dark_theme": {
          "enum": [
            "two-files",
            "css-variables",
            "dim"
          ]
        },
        "places": {
          "type": "array",
          "maxItems": 8,
          "description": "Места иллюстраций в продукте и размер показа (ui 07/02 §1.1); рабочие экраны, шапка и декоративный фон — не места.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "place",
              "size_px"
            ],
            "properties": {
              "place": {
                "enum": [
                  "empty-state",
                  "onboarding",
                  "error",
                  "success",
                  "announcement",
                  "task-card"
                ],
                "description": "пустое состояние, онбординг, ошибка (404, 500, нет доступа), успех, анонс, карточка задачи"
              },
              "size_px": {
                "type": "integer",
                "minimum": 16,
                "maximum": 640
              }
            }
          }
        },
        "format": {
          "enum": [
            "svg",
            "webp",
            "avif",
            "png"
          ],
