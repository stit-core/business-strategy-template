  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "oklch": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      ],
      "description": "[L 0–1, C 0–0,5, H 0–360°]"
    },
    "ratio": {
      "type": "string",
      "pattern": "^[0-9]{1,2}:[0-9]{1,2}$"
    },
    "palette_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "hex",
        "name",
        "share_max"
      ],
      "properties": {
        "role": {
          "enum": [
            "background",
            "dominant",
            "secondary",
            "accent",
            "text",
            "shadow",
            "highlight"
          ],
          "description": "Как в asset-spec palette.role."
        },
        "hex": {
          "$ref": "#/$defs/hex"
        },
        "name": {
          "type": "string",
          "description": "Название по-английски: hex без названия в промт не отправлять (BFL)."
        },
        "share_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Потолок доли площади; в спецификацию уходит как share."
        },
        "applies_to": {
          "type": "string"
        },
        "strict": {
          "type": "boolean",
          "description": "Бренд-цвет, который обязан совпасть (ΔE ≤ palette_dE_max): доводка постобработкой или HTML-слоем."
        },
        "source": {
          "enum": [
            "token",
            "reference",
            "derived",
            "vlm"
          ]
        },
        "token": {
          "type": "string",
          "description": "Путь токена DTCG: color.accent.solid."
        }
      }
    }
  }
}
